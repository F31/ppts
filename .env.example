# Database
POSTGRES_PASSWORD=postgres
PPTS_DATABASE_URL=postgres://ppts_app:ppts_dev_pw@postgres:5433/ppts_dev?sslmode=disable

# Object storage secret (32-byte base64)
PPTS_OBJECT_SECRET=
# Generate one with: openssl rand -base64 32

# Tenant / Auth (dev mode)
PPTS_AUTH_DEV_HEADERS=true
PPTS_OIDC_ISSUER=
PPTS_OIDC_CLIENT_ID=
PPTS_OIDC_TENANT_CLAIM=
PPTS_OIDC_USER_CLAIM=

# Gateway (optional)
PPTS_GATEWAY_AES_KEY_BASE64=
