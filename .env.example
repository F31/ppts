# Database
POSTGRES_PASSWORD=postgres
PPTS_DATABASE_URL=postgres://ppts_app:ppts_dev_pw@postgres:5433/ppts_dev?sslmode=disable

# Object storage secret (32-byte base64)
PPTS_OBJECT_SECRET=
# Generate one with: openssl rand -base64 32

# Tenant / Auth (dev mode)
# 注意：置真后服务接受 X-PPTS-Tenant-ID / X-PPTS-User-ID 两个未签名请求头，
# 等价于任何人都能冒充任意租户的任意用户——仅限本机开发，禁止用于任何共享环境。
# 未设置且也没配 PPTS_JWT_SECRET / OIDC 时，服务会拒绝启动（fail-closed）。
PPTS_AUTH_DEV_HEADERS=true
# 生产必须设置其一，否则服务启动失败。
PPTS_JWT_SECRET=
PPTS_OIDC_ISSUER=
PPTS_OIDC_CLIENT_ID=
PPTS_OIDC_TENANT_CLAIM=
PPTS_OIDC_USER_CLAIM=

# Gateway (optional)
PPTS_GATEWAY_AES_KEY_BASE64=

# Observability 端点鉴权
# /metrics 与 /debug/vars 都要求 Authorization: Bearer <token>，未配置本值时**一律拒绝**
# （fail-closed：忘配 = 拒绝，而不是裸奔）。/debug/vars 会导出完整启动命令行，
# 命令行参数可能含密钥，因此不当投资料。
# 本机调试如需匿名拉取指标，显式置真 PPTS_DEBUG_VARS_PUBLIC=true（同样仅限本机）。
# Prometheus 抓取请配同样的 Bearer（prometheus.yml: authorization.credentials）。
PPTS_METRICS_TOKEN=
PPTS_DEBUG_VARS_PUBLIC=false

# 对象存储 DELETE /ppts/object 路由开关。
# 当前没有任何签发方产出 OpDelete 令牌（PUT/GET 的上传一张 gird12持也不签发），
# 该能力无人使用，默认不挂载；置真才挂载，并会打印一条启动日志。
PPTS_OBJECT_ALLOW_DELETE=false

# TTS 文本规范化引擎（V2.8）显式开关。默认关闭（配音零行为回退）；
# 置 true 后 worker 对每段讲稿执行「〔读：x〕读音 / ‖ 停顿 / 发音词典 + 平台种子」规范化，
# 停顿事件映射 SpeechControl.Pauses（供应商支持才真停顿，否则回显 Warning）。
# 平台默认发音词典由迁移预置（pronunciation_dictionaries.is_platform_default），
# 关闭时不读取，绝不影响既有配音路径。
PPTS_TEXT_NORM_ENABLED=false
