{
  "name": "ppts-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "contrast": "node contrast.mjs",
    "i18n:check": "node i18n-check.mjs",
    "api:check": "node api-contract-check.mjs",
    "route:check": "node route-inventory-check.mjs",
    "core:test": "node --experimental-strip-types --test core-check.mjs",
    "polling:test": "node --experimental-strip-types --test polling-check.mjs",
    "freeze:test": "node --experimental-strip-types --test player-freeze-check.mjs",
    "build": "npm run contrast && npm run api:check && npm run route:check && npm run core:test && npm run polling:test && npm run freeze:test && npm run animation:test && npm run script:test && npm run visibility:test && npm run preview:test && npm run report:test && npm run anchors:test && npm run ttsmodel:test && npm run compare:test && npm run focus:test && npm run focuspreview:test && npm run gateway:test && npm run localauth:test && tsc -b && vite build",
    "build:share": "vite build --config vite.share.config.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 0.0.0.0",
    "animation:test": "node --experimental-strip-types --test animation-check.mjs",
    "script:test": "node --experimental-strip-types --test script-history-check.mjs",
    "visibility:test": "node --experimental-strip-types --test slide-visibility-check.mjs",
    "preview:test": "node --experimental-strip-types --test voice-preview-check.mjs",
    "report:test": "node --experimental-strip-types --test import-report-check.mjs",
    "anchors:test": "node --experimental-strip-types --test source-anchors-check.mjs",
    "ttsmodel:test": "node --experimental-strip-types --test tts-model-check.mjs",
    "compare:test": "node --experimental-strip-types --test script-compare-check.mjs",
    "focus:test": "node --experimental-strip-types --test script-focus-check.mjs",
    "focuspreview:test": "node --experimental-strip-types --test animation-preview-check.mjs",
    "gateway:test": "node --experimental-strip-types --test gateway-share-check.mjs",
    "localauth:test": "node --experimental-strip-types --test local-auth-check.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
