# ppts 单机配置（由 install.sh 生成到 /etc/ppts/config.env，两个服务共用）
# 语法：KEY=VALUE，systemd EnvironmentFile 逐行加载，不要加引号与 export。

# 数据库（应用运行账号，RLS 生效；迁移由 install.sh 用 superuser 另行执行）
PPTS_DATABASE_URL=postgres://ppts_app:CHANGE_ME@127.0.0.1:5432/ppts?sslmode=disable
# 调度账号（ADR-018）：worker 跨租户领取任务专用，仅持有受限调度函数 EXECUTE 权限
PPTS_SCHEDULER_DATABASE_URL=postgres://ppts_scheduler:CHANGE_ME@127.0.0.1:5432/ppts?sslmode=disable

# API 监听地址
PPTS_HTTP_ADDR=:8080

# 对象存储：local 单机模式（数据落 PPTS_OBJECT_ROOT）；换 S3 见 README「对象存储后端」
PPTS_OBJECT_BACKEND=local
PPTS_OBJECT_ROOT=/var/lib/ppts/objects
# 本地存储签名密钥（32 字节 base64，install.sh 自动生成）
PPTS_OBJECT_SECRET=CHANGE_ME

# 认证：邮箱注册的 JWT 密钥与密码 pepper（32 字节 base64，自动生成）
PPTS_JWT_SECRET=CHANGE_ME
PPTS_PASSWORD_PEPPER=CHANGE_ME
# 生产必须为 false；仅本地联调可开 true（允许 X-PPTS-Tenant-ID 开发头）
PPTS_AUTH_DEV_HEADERS=false
# 外部 OIDC（可选，配置后与 JWT 并存）
PPTS_OIDC_ISSUER=
PPTS_OIDC_CLIENT_ID=

# TTS：缺省 fake（静音占位，跑通链路用）；接正式服务时改为对应 provider 并补下列项
PPTS_TTS_PROVIDER=fake
PPTS_TTS_BASE_URL=
PPTS_TTS_API_KEY=
PPTS_TTS_MODEL=
PPTS_TTS_VOICE=

# 模型网关 AES 密钥（32 字节 base64，install.sh 自动生成；为空时 /api/model-gateways 全部 503）
PPTS_GATEWAY_AES_KEY_BASE64=CHANGE_ME
