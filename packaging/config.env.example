# ppts 单机配置（由 install.sh 生成到 /etc/ppts/config.env，两个服务共用）
# 语法：KEY=VALUE，systemd EnvironmentFile 逐行加载，不要加引号与 export。

# ─── 数据库驱动 ──────────────────────────────────────────────────────────────
# sqlite   = 单租户轻量模式（默认）：无需外部数据库，数据落 PPTS_DATABASE_URL 指定的文件；
#            无登录（固定本地租户/用户）、无多租户/协作/公开区，保留策略后台循环不启用。
# postgres = 多租户全功能模式：RLS + 权限/成员/协作 + 调度双连接 + 邮箱/OIDC 登录。
# 留空时按 PPTS_DATABASE_URL 前缀推断：postgres:// → postgres，其余 → sqlite。
# SQLite 示例：PPTS_DB_DRIVER=sqlite
#              PPTS_DATABASE_URL=/var/lib/ppts/ppts.db   （留空则默认 ~/.ppts/ppts.db）
# 切换到 PostgreSQL 时删除/注释 SQLite 行并按下节配置连接串。
PPTS_DB_DRIVER=

# 数据库（应用运行账号，RLS 生效；迁移由 install.sh 用 superuser 另行执行）
PPTS_DATABASE_URL=postgres://ppts_app:CHANGE_ME@127.0.0.1:5432/ppts?sslmode=disable
# 调度账号（ADR-018）：worker 跨租户领取任务专用，仅持有受限调度函数 EXECUTE 权限
PPTS_SCHEDULER_DATABASE_URL=postgres://ppts_scheduler:CHANGE_ME@127.0.0.1:5432/ppts?sslmode=disable

# API 监听地址
PPTS_HTTP_ADDR=:8080

# 对象存储：local 单机模式（数据落 PPTS_OBJECT_ROOT）；换 S3 见 README「对象存储后端」
PPTS_OBJECT_BACKEND=local
PPTS_OBJECT_ROOT=/var/lib/ppts/objects
# 本地存储签名密钥（32 字节 base64，install.sh 自动生成）
PPTS_OBJECT_SECRET=CHANGE_ME

# 认证：邮箱/手机注册的 JWT 密钥与密码 pepper（32 字节 base64，自动生成）
PPTS_JWT_SECRET=CHANGE_ME
PPTS_PASSWORD_PEPPER=CHANGE_ME
# 会话有效期（Go duration，如 24h/12h/30m）；默认 24h。生产建议 ≤24h。
PPTS_JWT_TTL=24h
# 生产必须为 false；仅本地联调可开 true（允许 X-PPTS-Tenant-ID 开发头）
PPTS_AUTH_DEV_HEADERS=false
# 外部 OIDC（可选，配置后与 JWT 并存）
PPTS_OIDC_ISSUER=
PPTS_OIDC_CLIENT_ID=

# ─── 认证安全（第一批：邮箱验证 / 密码重置 / Cookie 会话 / 安全头）────────────
# 邮件后端：smtp=真实发信；log=把验证/重置链接打到服务端日志（仅联调）；disabled=禁用。
# 留空时：配置了 PPTS_SMTP_HOST 用 smtp，否则 disabled。
PPTS_MAIL_BACKEND=
PPTS_SMTP_HOST=
PPTS_SMTP_PORT=587
PPTS_SMTP_USER=
PPTS_SMTP_PASSWORD=
# 发件人地址（如 "PPTS <no-reply@example.com>"；缺省回退 SMTP_USER）
PPTS_SMTP_FROM=
# TLS 模式：starttls（587，默认）| tls（465 隐式）| none（内网明文）
PPTS_SMTP_TLS=starttls
# 邮件内验证/重置链接的基址（必须是用户可访问的 HTTPS 地址，如 https://app.example.com）
PPTS_PUBLIC_BASE_URL=
# true 时未验证邮箱的账号禁止登录（默认 false：登录后软提示验证）
PPTS_REQUIRE_EMAIL_VERIFIED=false
# 部署在受控反向代理之后时置 true：信任 X-Forwarded-For/X-Forwarded-Proto
# （用于客户端 IP 限流与 Secure Cookie 判定；不要在未受控直连时开启）
PPTS_TRUST_PROXY=false
# 强制 Cookie 置 Secure（HTTPS 部署且代理未传 X-Forwarded-Proto 时使用）
PPTS_COOKIE_SECURE=false
# TLS 终止后开启 HSTS（Strict-Transport-Security）
PPTS_HSTS=false
# 安全响应头总开关（排障可临时 false）；CSP 默认启用
PPTS_SECURITY_HEADERS=true
# CSP connect-src 额外来源（空格分隔），例如外部 OIDC 令牌端点：
# PPTS_CSP_CONNECT_EXTRA="https://idp.example.com https://api.example.com"
PPTS_CSP_CONNECT_EXTRA=

# ─── 注册治理与运营商（第二批）──────────────────────────────────────────────
# false = 关闭自助注册（封闭注册/维护期）
PPTS_REGISTRATION_ENABLED=true
# 非空时注册必须携带匹配邀请码
PPTS_REGISTRATION_INVITE_CODE=
# 单 IP 每日注册上限（0=不额外限制，仅用每小时限流）
PPTS_REGISTER_DAILY_PER_IP=5
# 新租户默认免费配音额度（秒）；<0 不限量，=0 不发放
PPTS_DEFAULT_GEN_SECONDS_LIMIT=600
# 运营商用户 ID（逗号分隔）：可访问 /admin 跨租户查看/挂起/恢复
PPTS_OPERATOR_USER_IDS=

# Prometheus 指标 /metrics：可选 Bearer token（留空则按内网抓取放行）
PPTS_METRICS_TOKEN=
# 指标是否带租户维度标签（默认关闭，避免高基数）
PPTS_METRICS_TENANT_LABELS=false

# TTS：缺省 fake（静音占位，跑通链路用）；接正式服务时改为对应 provider 并补下列项
PPTS_TTS_PROVIDER=fake
PPTS_TTS_BASE_URL=
PPTS_TTS_API_KEY=
PPTS_TTS_MODEL=
PPTS_TTS_VOICE=

# 模型网关 AES 密钥（32 字节 base64，install.sh 自动生成；为空时 /api/model-gateways 全部 503）
PPTS_GATEWAY_AES_KEY_BASE64=CHANGE_ME
