# ppts 单机配置（由 install.sh 生成到 /etc/ppts/config.env，两个服务共用）
# 语法：KEY=VALUE。systemd EnvironmentFile 逐行加载，不要加引号，不要写 export。
#
# 未出现在本文件里的键使用代码缺省。全表（含测试与工具键）见 packaging/config.md。
# 本文件是 PostgreSQL 安装模板。什么都不设时进程走 sqlite：数据在 ~/.ppts/ppts.db，
# 无登录、动画默认开、配音必须另配供应商或模型网关，否则 worker 拒绝启动。
# 布尔只认 1/true/yes/on 与 0/false/no/off。时长用 Go 语法（30s、5m、720h）。
# 间隔与超时写 0 或负数会退回缺省，不会关闭功能；要关用对应的布尔开关。

# ─── 数据库 ───
# postgres 为连接串（须为非 owner 的受限账号）；sqlite 为文件路径。sqlite 且留空时用 ~/.ppts/ppts.db。
# 缺省：（空）。本模板：postgres://ppts_app:CHANGE_ME@127.0.0.1:5432/ppts?sslmode=disable
PPTS_DATABASE_URL=postgres://ppts_app:CHANGE_ME@127.0.0.1:5432/ppts?sslmode=disable
# sqlite 或 postgres。留空时按连接串推断：postgres:// 走 postgres，其余走 sqlite。
# 缺省：（空）
PPTS_DB_DRIVER=
# 迁移用超级用户连接串。留空则回退 PPTS_DATABASE_URL。
# 缺省：（空）
PPTS_MIGRATE_DATABASE_URL=
# worker 跨租户领取任务的调度账号。留空则用应用账号；单租户 sqlite 不需要。
# 缺省：（空）。本模板：postgres://ppts_scheduler:CHANGE_ME@127.0.0.1:5432/ppts?sslmode=disable
PPTS_SCHEDULER_DATABASE_URL=postgres://ppts_scheduler:CHANGE_ME@127.0.0.1:5432/ppts?sslmode=disable
# worker 只处理这一个租户。留空且为 postgres 时跨租户领取。
# 缺省：（空）
PPTS_TENANT_ID=

# ─── HTTP ───
# API 监听地址。
# 缺省：:8080
PPTS_HTTP_ADDR=:8080
# 前端静态目录。留空则使用二进制内嵌的 web/dist。
# 缺省：（空）
PPTS_WEB_ROOT=

# ─── 对象存储 ───
# 租户自带存储凭据的 AES 密钥。留空时模型网关密钥也可兼作此用途。
# 缺省：（空）
PPTS_BYOS_AES_KEY_BASE64=
# 挂载对象 DELETE 路由。当前没有签发方产出删除令牌，默认关闭。
# 缺省：false
PPTS_OBJECT_ALLOW_DELETE=false
# local、s3，或租户策略里的 byos:<credential_id>。
# 缺省：local
PPTS_OBJECT_BACKEND=local
# 对象信封加密密钥（32 字节 base64）。留空则不加密。启用后该租户不能走预签名直读。
# 缺省：（空）
PPTS_OBJECT_ENCRYPTION_KEY_BASE64=
# 本地对象存储根目录。local 后端必填，否则没有存储后端、进程起不来。
# 缺省：（空）。本模板：/var/lib/ppts/objects
PPTS_OBJECT_ROOT=/var/lib/ppts/objects
# 本地签名链接密钥，32 字节 base64。install.sh 会换成随机值。换密钥会使已签发链接失效。
# 缺省：（空）。本模板：CHANGE_ME
PPTS_OBJECT_SECRET=CHANGE_ME
# S3 访问密钥。
# 缺省：（空）
PPTS_S3_ACCESS_KEY=
# S3 桶名。
# 缺省：（空）
PPTS_S3_BUCKET=
# S3 兼容端点。留空则不注册 s3 后端。
# 缺省：（空）
PPTS_S3_ENDPOINT=
# S3 区域。
# 缺省：（空）
PPTS_S3_REGION=
# S3 秘密密钥。
# 缺省：（空）
PPTS_S3_SECRET_KEY=
# 访问 S3 端点时使用 TLS。写错的值会拒绝启动，而不是静默改成明文。
# 缺省：false
PPTS_S3_USE_SSL=false

# ─── 认证与注册 ───
# 接受未签名的 X-PPTS-Tenant-ID / X-PPTS-User-ID。只用于本机开发。
# 缺省：false
PPTS_AUTH_DEV_HEADERS=false
# 单 IP 每小时注册请求上限，含失败请求。非正数退回 60。
# 缺省：60
PPTS_AUTH_REGISTER_PER_HOUR=60
# 强制会话 Cookie 带 Secure。HTTPS 且代理未传协议头时打开。
# 缺省：false
PPTS_COOKIE_SECURE=false
# 邮箱登录的 JWT 签名密钥。与 OIDC 都没配、且没开开发头时，服务拒绝启动。
# 缺省：（空）。本模板：CHANGE_ME
PPTS_JWT_SECRET=CHANGE_ME
# 会话有效期。非法或缺失时用 24h。
# 缺省：24h
PPTS_JWT_TTL=24h
# OIDC client id。
# 缺省：（空）
PPTS_OIDC_CLIENT_ID=
# OIDC issuer。留空则不启用 OIDC。
# 缺省：（空）
PPTS_OIDC_ISSUER=
# 从 token 取租户 ID 的 claim。
# 缺省：tenant_id
PPTS_OIDC_TENANT_CLAIM=tenant_id
# 从 token 取用户 ID 的 claim。
# 缺省：sub
PPTS_OIDC_USER_CLAIM=sub
# 逗号分隔的运营商用户 ID，可访问 /admin。
# 缺省：（空）
PPTS_OPERATOR_USER_IDS=
# 密码 pepper，32 字节 base64。不入库。更换会使已有密码无法校验。
# 缺省：（空）。本模板：CHANGE_ME
PPTS_PASSWORD_PEPPER=CHANGE_ME
# 单 IP 每日成功注册上限。0 表示不另加每日限制。
# 缺省：20
PPTS_REGISTER_DAILY_PER_IP=20
# 关闭则禁止自助注册。
# 缺省：true
PPTS_REGISTRATION_ENABLED=true
# 非空时注册必须带匹配的邀请码。
# 缺省：（空）
PPTS_REGISTRATION_INVITE_CODE=
# 未验证邮箱的账号禁止登录。默认只在登录后提示验证。
# 缺省：false
PPTS_REQUIRE_EMAIL_VERIFIED=false
# 信任 X-Forwarded-For / X-Forwarded-Proto。只在受控反向代理后开启。
# 缺省：false
PPTS_TRUST_PROXY=false

# ─── 邮件 ───
# smtp、log 或 disabled。留空时：配了 SMTP_HOST 用 smtp，否则不发信。
# 缺省：（空）
PPTS_MAIL_BACKEND=
# 邮件里验证链接的公网基址，如 https://app.example.com。留空则按请求推导。
# 缺省：（空）
PPTS_PUBLIC_BASE_URL=
# 发件人。留空则回退 SMTP 用户名。
# 缺省：（空）
PPTS_SMTP_FROM=
# SMTP 主机。smtp 后端必填。
# 缺省：（空）
PPTS_SMTP_HOST=
# SMTP 密码。
# 缺省：（空）
PPTS_SMTP_PASSWORD=
# SMTP 端口。非法值拒绝启动。
# 缺省：587
PPTS_SMTP_PORT=587
# starttls、tls 或 none。
# 缺省：starttls
PPTS_SMTP_TLS=starttls
# SMTP 用户名。
# 缺省：（空）
PPTS_SMTP_USER=

# ─── 安全响应头 ───
# CSP connect-src 的额外来源，空格分隔。
# 缺省：（空）
PPTS_CSP_CONNECT_EXTRA=
# 发送 Strict-Transport-Security。只在 TLS 终止之后打开。
# 缺省：false
PPTS_HSTS=false
# 安全响应头总开关。排障可临时关闭。
# 缺省：true
PPTS_SECURITY_HEADERS=true

# ─── 额度与导出 ───
# 新租户默认免费配音秒数。0 不发放，负数不限量。
# 缺省：600
PPTS_DEFAULT_GEN_SECONDS_LIMIT=600
# 单工程成品时长上限（分钟）。0 不限。超限在写出产物前失败。
# 缺省：60
PPTS_MAX_EXPORT_DURATION_MINUTES=60
# 单个 PPT 的页数上限。非正数退回 100。
# 缺省：100
PPTS_MAX_PARSE_PAGES=100
# 上传与解析共用的文件上限，缺省 100 MiB。大于此值的文件前端会拒绝，解析也会拒绝。调大后浏览器里的 100 MB 提示仍是前端常量，需要一并改。
# 缺省：104857600
PPTS_MAX_UPLOAD_BYTES=104857600
# 定价表 JSON。留空使用内置占位价。非法 JSON 拒绝加载定价。
# 缺省：（空）
PPTS_PRICE_BOOK=

# ─── 指标与链路 ───
# 允许匿名读 /debug/vars。该端点会带出启动命令行，只用于本机。
# 缺省：false
PPTS_DEBUG_VARS_PUBLIC=false
# 指标是否带租户标签。默认关，避免高基数。
# 缺省：false
PPTS_METRICS_TENANT_LABELS=false
# /metrics 与 /debug/vars 的 Bearer。留空则一律拒绝，不会匿名暴露指标。
# 缺省：（空）
PPTS_METRICS_TOKEN=
# OTLP HTTP 端点。留空则不导出链路。
# 缺省：（空）
PPTS_OTEL_EXPORTER_OTLP_ENDPOINT=
# 挂载 /debug/pprof。即使打开也仍要过指标 token。
# 缺省：false
PPTS_PPROF=false
# shared 为跨副本的数据库计数；memory 退回进程内计数（维护窗口）。
# 缺省：shared
PPTS_RATELIMIT_BACKEND=shared
# worker 单独监听指标的地址，如 127.0.0.1:8081。留空则 worker 不另开端口。
# 缺省：（空）
PPTS_WORKER_METRICS_ADDR=

# ─── 语音合成 ───
# 参考音频对应的文本。
# 缺省：（空）
PPTS_COSYVOICE_PROMPT_TEXT=
# CosyVoice 零样本参考音频路径。用到该供应商时必填。
# 缺省：（空）
PPTS_COSYVOICE_PROMPT_WAV=
# 一段配音里的合成并发。0 表示跟随供应商声明；未声明时串行。只能调低，不能高于供应商声明。
# 缺省：0
PPTS_NARRATION_TTS_CONCURRENCY=0
# TTS API 密钥。
# 缺省：（空）
PPTS_TTS_API_KEY=
# TTS 端点。硅基种子缺省 https://api.siliconflow.cn。
# 缺省：（空）
PPTS_TTS_BASE_URL=
# TTS 模型。硅基种子缺省 FunAudioLLM/CosyVoice2-0.5B。
# 缺省：（空）
PPTS_TTS_MODEL=
# fake 或 siliconflow。代码缺省为空：没有模型网关时 worker 拒绝启动，避免生产静默出静音。安装模板用 fake，让单机先跑通。正式配音改网关或 siliconflow。
# 缺省：（空）。本模板：fake
PPTS_TTS_PROVIDER=fake
# TTS 音色。
# 缺省：（空）
PPTS_TTS_VOICE=

# ─── 大模型 ───
# 模型网关与消息服务凭据的 AES-256 密钥，32 字节 base64。留空则这些接口返回 503。
# 缺省：（空）。本模板：CHANGE_ME
PPTS_GATEWAY_AES_KEY_BASE64=CHANGE_ME
# 大模型 API 密钥。
# 缺省：（空）
PPTS_LLM_API_KEY=
# 大模型端点。硅基种子缺省 https://api.siliconflow.cn。
# 缺省：（空）
PPTS_LLM_BASE_URL=
# 对话模型。硅基种子缺省 Qwen/Qwen2.5-7B-Instruct。
# 缺省：（空）
PPTS_LLM_MODEL=
# 留空或 none 表示不启用大模型。当前只接受 siliconflow。
# 缺省：（空）
PPTS_LLM_PROVIDER=
# PPTS_LLM_TIMEOUT 的旧名。两者都设时用新名。
# 缺省：180s。本模板：（空）
PPTS_LLM_REQUEST_TIMEOUT=
# 大模型 HTTP 超时。也认旧名 PPTS_LLM_REQUEST_TIMEOUT，新名优先。
# 缺省：180s
PPTS_LLM_TIMEOUT=180s
# 视觉模型。留空则不提取视觉锚点。硅基直连时的库内缺省名是 Qwen/Qwen3-VL-8B-Instruct，但不会自动启用。
# 缺省：（空）
PPTS_LLM_VISION_MODEL=
# 讲稿草稿缓存。关掉则每次都重新生成。
# 缺省：true
PPTS_SCRIPT_DRAFT_CACHE=true
# 讲稿草稿生成的并发。
# 缺省：3
PPTS_SCRIPT_DRAFT_CONCURRENCY=3

# ─── 文本规范化 ───
# 逗号分隔的类别，如 percent,date,money,unit。留空不注册。
# 缺省：（空）
PPTS_TEXT_NORM_CLASSES=
# 配音前的文本规范化。默认关，避免改变已有音频。
# 缺省：false
PPTS_TEXT_NORM_ENABLED=false
# 每个 worker 缓存的引擎个数。小于等于 0 关闭缓存。
# 缺省：256
PPTS_TEXT_NORM_ENGINE_MAX=256
# 规范化引擎缓存时间。显式 0 关闭缓存（这是少数允许 0 的键，非法值也会关掉缓存并打日志）。
# 缺省：5m
PPTS_TEXT_NORM_ENGINE_TTL=5m
# quantity 或 year。留空不注册数值读法。
# 缺省：（空）
PPTS_TEXT_NORM_NUMBERS=

# ─── 任务执行 ───
# 队列最老等待时间的采样间隔。
# 缺省：30s
PPTS_QUEUE_BACKLOG_INTERVAL=30s
# 队列深度的采样间隔。
# 缺省：30s
PPTS_QUEUE_DEPTH_INTERVAL=30s
# LibreOffice/poppler 不可用时拒绝启动。默认只打日志并继续，页面图会缺失。
# 缺省：false
PPTS_REQUIRE_RENDERER=false
# 租户策略的进程内缓存。关掉则每次对象操作都读库。
# 缺省：true
PPTS_TENANT_POLICY_CACHE=true
# 策略缓存有效期，也是跨进程看见策略变更的上限。同进程 SetPolicy 会立刻失效。
# 缺省：30s
PPTS_TENANT_POLICY_CACHE_TTL=30s
# worker 同时执行的任务数。
# 缺省：2
PPTS_WORKER_CONCURRENCY=2
# 单个任务最多尝试次数。
# 缺省：10
PPTS_WORKER_MAX_ATTEMPTS=10

# ─── 动画 ───
# 页图资产目录。导出进程写入，渲染容器读取同一目录。留空则预览与动画导出不可用。
# 缺省：（空）
PPTS_ANIMATION_ASSET_DIR=
# 动画总开关。未设置时 sqlite 为开、postgres 为关。安装模板按 postgres 写成 false。
# 缺省：（空）。本模板：false
PPTS_ANIMATION_ENABLED=false
# 单页预览从提交到拿到字节的预算。合法范围 1s–60s，超出会被夹紧。留空用 3s。
# 缺省：3s
PPTS_ANIMATION_PREVIEW_BUDGET=3s
# 预览 HTTP 客户端超时。必须大于预览预算上限 60s，否则预算还没到客户端先断开。
# 缺省：70s
PPTS_ANIMATION_PREVIEW_CLIENT_TIMEOUT=70s
# 导出对话框探测渲染服务是否在线的超时。要短，否则对话框会卡住。慢机器请加长，不要和 worker 的 30s 混用。
# 缺省：3s
PPTS_ANIMATION_PROBE_TIMEOUT=3s
# 租户没配策略时的灰度百分比 0–100。非法值退回 100，避免写错把所有人的动画关掉。要收口请显式写 0。
# 缺省：100
PPTS_ANIMATION_ROLLOUT=100
# 灰度分桶盐。写进配置后不要再改，改了等于重新洗牌。
# 缺省：（空）
PPTS_ANIMATION_ROLLOUT_SALT=
# 一段动画导出任务的总超时（分钟）。
# 缺省：20
PPTS_ANIMATION_TIMEOUT_MINUTES=20
# worker 调用渲染服务的 HTTP 超时（秒）。这是单次请求，不是整段动画任务。
# 缺省：30
PPTS_RENDERER_TIMEOUT_SECONDS=30
# 渲染服务地址，如 http://127.0.0.1:8090。留空则不出动画、也不做字体子集。
# 缺省：（空）
PPTS_RENDERER_URL=

# ─── 页面渲染 ───
# chrome-headless-shell 或 Chrome 的路径。留空则交给 Remotion 自己找。
# 缺省：（空）
PPTS_CHROME=
# node 可执行文件。
# 缺省：node
PPTS_NODE=node
# pdfinfo 路径。留空则在 PATH 里找。
# 缺省：（空）
PPTS_PDFINFO_BIN=
# pdftoppm 路径。留空则在 PATH 里找。
# 缺省：（空）
PPTS_PDFTOPPPM_BIN=
# renderer/render.mjs 的路径。
# 缺省：（空）
PPTS_RENDERER_SCRIPT=
# 渲染临时目录。Windows 上经 WSL 调用 soffice 时必须在 /mnt/<盘符> 下。
# 缺省：（空）
PPTS_RENDER_WORK_ROOT=
# LibreOffice soffice 路径。留空则在 PATH 里找。
# 缺省：（空）
PPTS_SOFFICE_BIN=
# 字幕字体名。留空用内置字体。
# 缺省：（空）
PPTS_SUBTITLE_FONT_NAME=

# ─── 保留与清理 ───
# 审计归档循环的间隔。
# 缺省：1h
PPTS_AUDIT_ARCHIVE_INTERVAL=1h
# 审计在库里保留的天数。0 或负数表示不按天清理。
# 缺省：365
PPTS_AUDIT_RETENTION_DAYS=365
# 终态任务保留期，缺省 30 天。到期删除会放开幂等键，同键可以再执行。写 0 不会关闭，只会退回 30 天。
# 缺省：720h
PPTS_JOB_RETENTION_TTL=720h
# 真的删除无引用对象。默认只写审计。确认候选后再开。
# 缺省：false
PPTS_ORPHAN_DELETE=false
# 无引用对象在删除或报告前的宽限。
# 缺省：24h
PPTS_ORPHAN_GRACE=24h
# 仍处于 reserved 的额度预占多久后释放。
# 缺省：24h
PPTS_QUOTA_RESERVATION_TTL=24h
# 保留清理循环的间隔。
# 缺省：1h
PPTS_RETENTION_INTERVAL=1h
# 向对象存储下发生命周期规则的间隔。
# 缺省：6h
PPTS_STORAGE_LIFECYCLE_INTERVAL=6h
# 未完成上传多久后清理。
# 缺省：24h
PPTS_UPLOAD_ABANDON_TTL=24h

# ─── 分享 ───
# 把匿名读取公开页记入审计。
# 缺省：false
PPTS_AUDIT_ANONYMOUS_ACCESS=false
# 公开分享页的遥测总开关。
# 缺省：true
PPTS_SHARE_TELEMETRY=true
