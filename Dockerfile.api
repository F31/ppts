FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends nginx curl ca-certificates && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default
COPY ppts-api /usr/local/bin/ppts-api
COPY web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
ENV PPTS_WEB_ROOT=/usr/share/nginx/html \
    PPTS_OBJECT_BACKEND=local \
    PPTS_OBJECT_ROOT=/data/objects \
    TZ=Asia/Shanghai
ENTRYPOINT ["sh", "-c", "ppts-api & nginx -g 'daemon off;'"]
