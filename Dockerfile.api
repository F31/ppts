# ppts api 镜像：单个 Go 进程同时提供 REST/Connect RPC 与前端静态资源。
#
# PPTS_WEB_ROOT 指向前端构建产物后，internal/api 会挂上 "/" 的 SPA 兜底
# （internal/api/server.go spaFallbackHandler），因此不再需要 nginx：
#   - 少一层反代，省掉 nginx 及其运行期依赖；
#   - 顺带消除旧拓扑的隐患：nginx 默认 client_max_body_size=1m，大于 1MB 的 PPTX 上传会被 413 拒绝。
# 静态资源缓存语义由 spaFallbackHandler 接替：/assets/ 下的内容哈希文件返回 immutable。
#
# 构建：docker compose build api

FROM golang:1.25-bookworm AS builder

# GOWORK=off：镜像内不存在 ../go-pptx 工作区，必须按 go.mod 锁定的模块版本解析依赖。
# 不要设 GOPRIVATE=github.com/F31 —— 那会绕过 GOPROXY 直连 GitHub，受限网络下必然失败。
ARG GOPROXY=https://goproxy.cn,direct
WORKDIR /build
COPY go.mod go.sum ./
RUN GOWORK=off GOPROXY=$GOPROXY go mod download
COPY . .
RUN CGO_ENABLED=0 GOWORK=off GOPROXY=$GOPROXY \
    go build -trimpath -ldflags="-s -w" -o /out/ppts ./cmd/ppts

FROM debian:bookworm-slim

# curl 仅用于 compose 的 healthcheck。
# apt 源默认走官方；本机可达性差时由 docker-compose.yml 传 APT_MIRROR=mirrors.aliyun.com。
ARG APT_MIRROR=deb.debian.org
RUN set -eux; \
    sed -i "s|deb.debian.org|${APT_MIRROR}|g" /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates tzdata curl; \
    rm -rf /var/lib/apt/lists/* /usr/share/doc

COPY --from=builder /out/ppts /usr/local/bin/ppts
COPY web/dist /app/web-dist

# 以非 root 运行。
#
# ⚠️ 端口代价：单机部署要占宿主机 80（docker-compose.yml 里 PPTS_HTTP_ADDR=:80，替掉旧拓扑
# 的 nginx），80 属特权端口，非 root 进程默认绑不了。因此必须由运行方显式授予
# NET_BIND_SERVICE 能力（compose 已加 cap_add）—— 少了它容器会启动即失败。
# 这不是可选加固项，两者必须一起改；只加 USER 不改编排 = 直接把服务改挂。
RUN set -eux; \
    groupadd -g 10001 ppts; \
    useradd -u 10001 -g ppts -m -d /home/ppts -s /usr/sbin/nologin ppts; \
    mkdir -p /data/objects; \
    chown -R 10001:10001 /data/objects /home/ppts

ENV PPTS_WEB_ROOT=/app/web-dist \
    PPTS_OBJECT_BACKEND=local \
    PPTS_OBJECT_ROOT=/data/objects \
    HOME=/home/ppts \
    TZ=Asia/Shanghai

# 默认监听 8080（cmd/ppts/server.go）；compose 单机部署会覆盖为 :80，故 EXPOSE 只是声明，
# 真实端口以 PPTS_HTTP_ADDR 为准。
EXPOSE 8080

# HEALTHCHECK 必须与进程实际监听端口同源，否则会对着错误端口探活、结果永远不健康。
# 用 shell form 才能在运行时读到 ENV：把 ":80" 的前导冒号去掉拼进 URL。
# curl 的 -f 让 5xx 直接失败 —— 依赖不可用时容器必须被标 unhealthy，这正是探活的意义。
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD addr="${PPTS_HTTP_ADDR:-:8080}"; curl -fsS "http://127.0.0.1:${addr#:}/healthz" || exit 1

USER 10001:10001
ENTRYPOINT ["/usr/local/bin/ppts"]
CMD ["server"]
