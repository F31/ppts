# 运行时镜像：nginx:alpine + 预编译的 ppts-api 二进制
# 注意：构建时需先在本机执行 GOWORK=off go build -o ppts-api ./cmd/api
FROM nginx:alpine
COPY ppts-api /usr/local/bin/ppts-api
COPY web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
ENV PPTS_WEB_ROOT=/usr/share/nginx/html \
    PPTS_OBJECT_BACKEND=local \
    PPTS_OBJECT_ROOT=/data/objects \
    TZ=Asia/Shanghai
ENTRYPOINT ["sh", "-c", "ppts-api & nginx -g 'daemon off;'"]
